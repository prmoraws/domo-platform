() }}","type":"string"}]},"includeOtherFields":true,"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.5,"position":[-672,-96],"id":"a2b4f686-96ac-4dc1-8fed-855c1c2b415f","name":"Preparar pergunta"},{"parameters":{"method":"POST","url":"={{ 'http://evolution:8080/message/sendText/' + $env.DOMO_WHATSAPP_INSTANCE_NAME }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"={{ $('Extrair comando').item.json.remoteJid.split('@')[0] }}\",\n  \"text\": \"{{ 'DOMO informa: existem ' + $('Executar consulta segura').item.json.result.total + ' pessoas cadastradas.' }}\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[-224,-224],"id":"aeeec8c1-6131-4ff3-96b8-960a4b8c793d","name":"Responder teste","credentials":{"httpHeaderAuth":{"id":"HPpjiwrjOHi43obN","name":"DOMO - Evolution API"}}},{"parameters":{"jsCode":"const question = String($json.question ?? '')\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .trim()\n  .toLowerCase();\n\nlet table = null;\n\nif (\n  question.includes('pessoa') ||\n  question.includes('pessoas') ||\n  question.includes('cadastrado') ||\n  question.includes('cadastradas')\n) {\n  table = 'pessoas';\n}\n\nif (!table) {\n  throw new Error(\n    'Ainda não reconheço essa consulta.',\n  );\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      operation: 'count_records',\n      table,\n    },\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-528,-128],"id":"be318859-b513-472c-ae31-8173f16ebc3a","name":"Interpretar consulta"},{"parameters":{"method":"POST","url":"http://api:3001/internal/database/query","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"operation\": \"{{ $json.operation }}\",\n  \"table\": \"{{ $json.table }}\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"positio