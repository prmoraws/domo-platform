# Identificação
COMPOSE_PROJECT_NAME=domo-platform
APP_ENV=development
TZ=America/Bahia

# PostgreSQL do n8n
POSTGRES_DB=domo_automation
POSTGRES_USER=domo_automation
POSTGRES_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

# n8n
N8N_ENCRYPTION_KEY=SUBSTITUIR_POR_CHAVE_ALEATORIA
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
# URL pública HTTPS usada por triggers/webhooks externos, inclusive Telegram.
# No ambiente atual do DOMO, o Tailscale Funnel usa este endereço:
N8N_WEBHOOK_URL=https://domo-n8n.tailbd3b60.ts.net/

# API DOMO
API_PORT=3001
API_INTERNAL_TOKEN=SUBSTITUIR_POR_TOKEN_ALEATORIO
API_HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_QUERY_MAX_ROWS=100

# Réplica MySQL do Laravel
MYSQL_DATABASE=domo_replica
REPLICA_BLUE_DATABASE=domo_replica
REPLICA_GREEN_DATABASE=domo_replica_staging
MYSQL_ROOT_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE
MYSQL_READONLY_USER=domo_reader
MYSQL_READONLY_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

# Agente de IA
GEMINI_API_KEY=SUBSTITUIR_POR_CHAVE_GEMINI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PLANNER_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://ollama:11434
OLLAMA_PLANNER_FALLBACK=false

# Qdrant
QDRANT_PORT=6333

EVOLUTION_API_KEY=SUBSTITUIR_POR_CHAVE_ALEATORIA
EVOLUTION_POSTGRES_DB=domo_evolution
EVOLUTION_POSTGRES_USER=domo_evolution
EVOLUTION_POSTGRES_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

DOMO_WHATSAPP_COMMAND_PREFIX=domo:
DOMO_WHATSAPP_INSTANCE_NAME=domo-assistente
DOMO_WHATSAPP_SESSION_MINUTES=20
DOMO_WHATSAPP_ALLOWED_JID=SUBSTITUIR_PELO_JID_AUTORIZADO
